[21.417965, "o", "\r\n\u001b[1;37mNow trigger a controlled API failure...\u001b[0m\r\n\r\n\u001b[1;36m❯ python3 docs/demo/toy_service.py crash\u001b[0m\r\n"]
[22.206334, "o", "crash trigger written for api\r\n"]
[24.23639, "o", "\r\n\u001b[1;36m❯ agent-procs --session \"$DEMO_SESSION\" wait api --until \"[agent-procs] Restarted\" --timeout 10\u001b[0m\r\n"]
