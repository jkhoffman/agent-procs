[0.057702, "o", "\u001b[2J\u001b[H\u001b[1;37mAgentProcs: resilient local agent workflow\u001b[0m\r\n\u001b[0;37mTwo dependent services · stable URLs · automatic crash recovery\u001b[0m\r\n\u001b[0;37mIsolated session: agent-procs-demo-e5fdd90feaa290e0446e879616a6d630\u001b[0m\r\n"]
[0.057727, "o", "\u001b[0;37m$ DEMO_SESSION=agent-procs-demo-e5fdd90feaa290e0446e879616a6d630\u001b[0m\r\n"]
[3.079887, "o", "\r\n\u001b[1;36m❯ agent-procs --session \"$DEMO_SESSION\" up --config docs/demo/agent-procs.yaml\u001b[0m\r\n"]
